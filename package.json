{
  "name": "n2n-nexus",
  "version": "0.4.2",
  "description": "Local-first MCP coordination hub from N2NS Lab for multi-AI assistant collaboration.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "n2n-nexus": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE",
    "docs/README_zh.md",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE_zh.md",
    "docs/ASSISTANT_GUIDE.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "multi-agent",
    "multi-agent-coordination",
    "multi-ai",
    "ai-agent",
    "ai-agent-coordination",
    "ai-assistant",
    "ai-assistant-collaboration",
    "coding-agent",
    "coding-assistant",
    "project-coordination",
    "project-context",
    "project-registry",
    "local-first",
    "local-first-mcp",
    "cross-ide",
    "ide-collaboration",
    "claude",
    "claude-desktop",
    "cursor",
    "vscode",
    "windsurf",
    "jetbrains",
    "developer-tools",
    "ai-developer-tools"
  ],
  "author": "N2NS Lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n2ns/n2n-nexus.git"
  },
  "homepage": "https://github.com/n2ns/n2n-nexus#readme",
  "bugs": {
    "url": "https://github.com/n2ns/n2n-nexus/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "daemon": "node build/index.js daemon",
    "dev": "tsc -w",
    "test": "vitest run",
    "test:publish": "npm run build && npm test && npm pack --dry-run",
    "test:integration": "vitest run tests/daemon_projects.test.ts tests/daemon_messages.test.ts tests/message_cursor.test.ts",
    "lint": "eslint src/**",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
