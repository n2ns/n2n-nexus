    "ai-agent",
    "ai-agent-coordination",
    "ai-assistant",
    "ai-assistant-collaboration",
    "coding-agent",
    "coding-assistant",
    "project-coordination",
    "project-context",
    "project-registry",
    "local-first",
    "local-first-mcp",
    "cross-ide",
    "ide-collaboration",
    "claude",
    "claude-desktop",
    "cursor",
    "vscode",
    "windsurf",
    "jetbrains",
    "developer-tools",
    "ai-developer-tools"
  ],
  "author": "N2NS Lab",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n2ns/n2n-nexus.git"
  },
