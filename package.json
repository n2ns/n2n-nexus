{
  "name": "n2n-nexus",
  "version": "0.11.0",
  "description": "Local-first MCP coordination hub from N2NS Lab for multi-AI assistant collaboration.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "n2n-nexus": "build/index.js"
  },
  "files": [
    "build",
    "contract/*.json",
    "assets",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "docs/CHANGELOG_zh.md",
    "LICENSE",
    "docs/README_zh.md",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE_zh.md",
    "docs/ASSISTANT_GUIDE.md",
    "docs/ASSISTANT_GUIDE_zh.md",
    "docs/INSTALL.md",
    "docs/INSTALL_zh.md",
    "docs/USER_GUIDE.md",
    "docs/USER_GUIDE_zh.md",
    "docs/TOOLS_REFERENCE.md",
    "docs/TOOLS_REFERENCE_zh.md",
    "docs/MEETING_MINUTES_2025-12-29.md",
    "docs/discussion_2025-12-29.md",
    "SECURITY.md",
    "docs/SECURITY_zh.md",
    "CONTRIBUTING.md",
    "docs/CONTRIBUTING_zh.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "multi-agent",
    "multi-agent-coordination",
    "multi-ai",
    "ai-agent",
    "ai-agent-coordination",
    "ai-assistant",
    "ai-assistant-collaboration",
    "coding-agent",
    "coding-assistant",
    "project-coordination",
    "project-context",
    "project-registry",
    "local-first",
    "local-first-mcp",
    "cross-ide",
    "ide-collaboration",
    "claude",
    "claude-desktop",
    "cursor",
    "vscode",
    "windsurf",
    "jetbrains",
    "developer-tools",
    "ai-developer-tools"
  ],
  "author": "N2NS Lab",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/n2ns"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n2ns/n2n-nexus.git"
  },
  "homepage": "https://github.com/n2ns/n2n-nexus#readme",
  "bugs": {
    "url": "https://github.com/n2ns/n2n-nexus/issues"
  },
  "engines": {
    "node": "^22.14.0 || >=23.6.0"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('build', { recursive: true, force: true })\" && tsc",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "host:build-test": "go build -tags testclock -o host/bin/test/ ./host/cmd/n2n-nexus-host",
    "test:conformance": "vitest run -c vitest.conformance.config.ts",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "pack:dry-run": "npm pack --dry-run",
    "check": "npm run lint && npm test && npm run build && npm run audit && npm run pack:dry-run",
    "test:publish": "npm run build && npm test && npm pack --dry-run",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
